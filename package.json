{
  "name": "@kaldenframe-labs/evidence-preflight",
  "version": "1.3.2",
  "description": "Schema, example, and local validator for KaldenFrame Evidence Preflight cards.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://kaldenframelabs.com/preflight/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaldenframelabs/evidence-preflight.git"
  },
  "bugs": {
    "url": "https://github.com/kaldenframelabs/evidence-preflight/issues"
  },
  "keywords": [
    "evidence",
    "provenance",
    "research",
    "schema",
    "validation"
  ],
  "sideEffects": false,
  "bin": {
    "evidence-preflight": "./bin/validate-evidence-card.mjs"
  },
  "exports": {
    ".": "./lib/evidence-preflight-v1.mjs",
    "./schema": "./schema/evidence-preflight-v1.schema.json",
    "./example": "./examples/evidence-preflight-v1.example.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "examples",
    "lib",
    "schema",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm test",
    "test": "node test/validate.mjs",
    "validate:example": "node bin/validate-evidence-card.mjs examples/evidence-preflight-v1.example.json"
  },
  "engines": {
    "node": ">=20"
  }
}
